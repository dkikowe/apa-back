NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27018/amanat?replicaSet=rs0
SESSION_SECRET=replace-with-at-least-32-random-characters
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=amanat-private
S3_ACCESS_KEY_ID=local-development
S3_SECRET_ACCESS_KEY=replace-local-storage-password
S3_FORCE_PATH_STYLE=true
# Set minio for MinIO; AWS is the default.
S3_PROVIDER=minio
S3_ENCRYPTION=AES256
OCR_LANG_PATH=.local/tessdata
OCR_LANGUAGES=kaz+rus+eng
# Production: HTTPS origin, secure cookies, Kazakhstan hosting, encrypted S3.

SERVE_FRONTEND=false
HOST=127.0.0.1
# Initial admin is created via npm run admin:create with ADMIN_USERNAME and ADMIN_PASSWORD.
